{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": "WordPress/WordPress#6.8.3",
	"phpVersion": "8.3",
	"plugins": [ "." ],
	"config": {
		"WP_DEBUG": true,
		"SCRIPT_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false
	},
	"lifecycleScripts": {
		"afterStart": "for SERVICE in cli tests-cli; do wp-env run \"$SERVICE\" wp plugin activate media-manager; done"
	},
	"env": {
		"development": {
			"multisite": true
		},
		"tests": {
			"multisite": false
		}
	}
}
