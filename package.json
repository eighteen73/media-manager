{
	"name": "media-manager",
	"version": "0.1.0",
	"description": "Native media folders, private media, shared multisite media, and safety-first cleanup.",
	"author": "eighteen73",
	"license": "GPL-2.0-or-later",
	"homepage": "https://eighteen73.co.uk",
	"main": "build/admin/index.js",
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"format": "npm run format:css && npm run format:js && npm run format:php",
		"format:css": "wp-scripts lint-style --fix \"./src/**/*.{css,scss}\" || true",
		"format:js": "wp-scripts lint-js --fix \"./src\" || true",
		"format:php": "composer run format",
		"lint": "npm run lint:css && npm run lint:js && npm run lint:php",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js \"./src\"",
		"lint:php": "composer run lint",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"postinstall": "composer install -o",
		"playwright:install": "playwright install chromium",
		"wp-env": "wp-env",
		"env": "wp-env",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"test": "npm run test:unit && npm run test:php && npm run test:e2e",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/media-manager vendor/bin/phpunit -c phpunit.xml.dist",
		"test:unit": "wp-scripts test-unit-js --config jest.config.js",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"pot": "wp i18n make-pot . languages/media-manager.pot --domain=media-manager --exclude=node_modules,vendor,.git,tests"
	},
	"devDependencies": {
		"@eighteen73/eslint-config-wordpress": "latest",
		"@eighteen73/stylelint-config-wordpress": "latest",
		"@playwright/test": "^1.51.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.2.0",
		"@wordpress/browserslist-config": "^6.52.0",
		"@wordpress/e2e-test-utils-playwright": "^1.52.0",
		"@wordpress/env": "^11.12.0",
		"@wordpress/prettier-config": "^4.52.0",
		"@wordpress/scripts": "^36.0.0",
		"lefthook": "latest",
		"postcss-preset-env": "latest"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.52.0",
		"@wordpress/components": "^38.0.0",
		"@wordpress/data": "^10.52.0",
		"@wordpress/element": "^8.4.0",
		"@wordpress/i18n": "^6.25.0"
	}
}
